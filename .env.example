# Firebase client SDK (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-side: session cookie verification, all admin
# Firestore writes, cron jobs). This must be the FULL service-account JSON
# (Project Settings > Service Accounts > Generate new private key in the
# Firebase console) pasted as ONE line, e.g.:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"...", ...}
# Note: without this set, adminAuth/adminDb are silently null and every
# server-side auth check, admin write, and cron job (current affairs,
# vocabulary, reminders) fails quietly.
FIREBASE_SERVICE_ACCOUNT=

# Cloudinary (server-side: signed uploads for the Digital Library feature).
# Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (Mission Control reminders / notifications). Generate a VAPID key
# pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@study-sphere-flax.vercel.app

# Shared secret for scheduled jobs (Vercel Cron -> /api/mission-ias/fetch-news,
# /api/mission-ias/generate-vocabulary, /api/cron/check-reminders). Set the
# same value here and as a Vercel env var; Vercel Cron sends it automatically
# as an Authorization: Bearer header once configured.
CRON_SECRET=

# AI provider: Google Gemini (server-side only). Used by mock test generation,
# AI chat, English Lab tools, and Mission IAS (current-affairs summaries,
# ethics feedback, vocabulary generation). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider: Anthropic Claude (server-side only; optional - features fall back
# gracefully to deterministic offline heuristics if unset).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
