rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isOwnerOfDoc() {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }
    function isCreatingOwnDoc() {
      return request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /sessions/{sessionId} { allow read, write: if isOwner(uid); }
      match /studyStats/{period} { allow read, write: if isOwner(uid); }
      match /tasks/{taskId} { allow read, write: if isOwner(uid); }
      match /weeklyPlan/{weekId} { allow read, write: if isOwner(uid); }
      match /monthlyPlan/{monthId} { allow read, write: if isOwner(uid); }
      match /pomodoroSessions/{sessionId} { allow read, write: if isOwner(uid); }
      match /focusSettings/{docId} { allow read, write: if isOwner(uid); }
      match /notes/{noteId} { allow read, write: if isOwner(uid); match /versions/{versionId} { allow read, write: if isOwner(uid); } }
      match /subjects/{subjectId} { allow read, write: if isOwner(uid); }
      match /journalEntries/{entryId} { allow read, write: if isOwner(uid); }
      match /flashcardDecks/{deckId} { allow read, write: if isOwner(uid); }
      match /flashcards/{cardId} { allow read, write: if isOwner(uid); }
      match /aiConversations/{conversationId} { allow read, write: if isOwner(uid); }
      match /bookmarkedNews/{itemId} { allow read, write: if isOwner(uid); }
      match /libraryFiles/{fileId} { allow read, write: if isOwner(uid); match /notes/{noteId} { allow read, write: if isOwner(uid); } match /bookmarks/{bookmarkId} { allow read, write: if isOwner(uid); } }
      match /libraryFolders/{folderId} { allow read, write: if isOwner(uid); }
      match /vocabProgress/{wordId} { allow read, write: if isOwner(uid); }
      match /ethicsCaseStudySessions/{sessionId} { allow read, write: if isOwner(uid); }
      match /englishWritingSessions/{sessionId} { allow read, write: if isOwner(uid); }
      match /englishSpeakingSessions/{sessionId} { allow read, write: if isOwner(uid); }
      match /customMockTests/{testId} { allow read, write: if isOwner(uid); }
      match /gamification/{docId} { allow read, write: if isOwner(uid); }
      match /mapProgress/{stateKey} { allow read, write: if isOwner(uid); }
      match /habits/{habitId} { allow read, write: if isOwner(uid); match /logs/{logId} { allow read, write: if isOwner(uid); } }
    }

    match /mockTestResults/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }
    match /testSessions/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }
    match /analyticsSnapshots/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }
    match /studyLogs/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }
    match /plans/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }
    match /missions/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }
    match /syllabusProgress/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }
    match /moodEntries/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }
    match /focusSessions/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }
    match /topicMastery/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }
    match /xpTransactions/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }
    match /sm2Data/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }
    match /mistakeEntries/{docId} { allow read, update, delete: if isOwnerOfDoc(); allow create: if isCreatingOwnDoc(); }

    match /currentAffairs/{itemId} { allow read: if request.auth != null; allow write: if false; }
    match /vocabulary/{wordId} { allow read: if request.auth != null; allow write: if false; }

    // Public realtime study community. Only authenticated users can see room/member state.
    match /studyRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
      match /members/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && uid == request.auth.uid;
        allow delete: if request.auth != null && uid == request.auth.uid;
      }
      match /focusSessions/{sessionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.startedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}